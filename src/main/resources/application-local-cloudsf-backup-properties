spring.application.name=autobridge-api
# ===== JDBC over Cloud SQL Socket Factory =====
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.datasource.url=jdbc:mysql:///autobridge?cloudSqlInstance=autobridge-backend-api:us-central1:autobridge-mysql&socketFactory=com.google.cloud.sql.mysql.SocketFactory&useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=utf8

# Replace with the DB user/password that exist inside the MySQL instance
spring.datasource.username=autobridge
spring.datasource.password=Amma@1998

spring.jpa.hibernate.ddl-auto=none
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
spring.jpa.open-in-view=false

# Optional: make startup fail fast if DB is unreachable
spring.sql.init.mode=never
spring.datasource.hikari.initializationFailTimeout=60000
server.port=8080

# (Optional) actuator for quick health checks
management.endpoints.web.exposure.include=health,info
