spring.datasource.url=jdbc:mysql://127.0.0.1:3307/autobridge?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&cachePrepStmts=true&prepStmtCacheSize=250&prepStmtCacheSqlLimit=2048
spring.datasource.username=autobridge
